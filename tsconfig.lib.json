{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "skipLibCheck": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* emit the engine as plain ESM + .d.ts; `./x.ts` imports are rewritten to `./x.js` */
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "rootDir": "src/dry",
    "outDir": "lib",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo"
  },
  "include": ["src/dry"],
  "exclude": ["src/dry/sample.ts", "src/dry/complete.ts"]
}
